#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE    0
#define SYMBOL  1
#define NUM     2
#define NAV     3
#define EDIT    4

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";

            // --------------------------------------------------------------------------------
            // |  ESC |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Z  |  U   |  I  |  O  |  P  | BSPC  |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  | RET   |
            // | SHFT |  Y  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | SHIFT |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E     &kp R  &kp T        &kp C_MUTE  &kp C_PP  &kp Z        &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LCTRL   &kp A  &kp S  &kp D     &kp F  &kp G        &kp LALT    &kp RALT  &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp RET
&kp LSHFT   &kp Y  &kp X  &kp C     &kp V  &kp B                              &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHIFT
                          &kp LGUI  &mo 1  &lt 3 SPACE                        &lt 4 ENTER  &mo 2  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        sym_layer {
            display-name = "Symbol";
            bindings = <
&trans  &kp DOT        &kp COMMA         &kp QUESTION    &kp EXCLAMATION       &kp AMPERSAND    &bt BT_SEL 0  &bt BT_CLR       &kp DOLLAR       &kp MINUS              &kp UNDERSCORE   &kp DOUBLE_QUOTES  &kt SQT           &trans
&trans  &kp LESS_THAN  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp SLASH        &bt BT_SEL 1  &rgb_ug RGB_TOG  &kp BACKSLASH    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp RIGHT_BRACKET  &kp GREATER_THAN  &trans
&trans  &kp TILDE      &kp ASTERISK      &kp PIPE        &kp COLON             &rgb_ug RGB_BRD                                 &rgb_ug RGB_BRI  &kp SEMI               &kp CARET        &kp PLUS           &kp EQUAL         &trans
                                         &trans          &trans                &trans                                          &trans           &trans                 &trans
            >;

            sensor-bindings = <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>;
        };

        Number {
            bindings = <
&trans  &trans        &trans        &kp PLUS      &kp MINUS     &trans        &trans  &trans  &kp ASTERISK     &kp SLASH        &trans           &trans           &trans           &trans
&trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &trans  &trans  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp NUMBER_0     &trans
&trans  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9                  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &trans
                                    &trans        &trans        &trans                        &trans           &trans           &trans
            >;
        };

        Navigation {
            bindings = <
&trans  &kp LG(Q)         &trans            &trans            &trans            &trans            &trans  &trans  &trans                &trans                &trans                &trans                &trans                &trans
&trans  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &trans  &trans  &kp LS(LG(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LG(LS(NUMBER_3))  &kp LG(LS(NUMBER_4))  &kp LG(LS(NUMBER_5))  &kp LG(ENTER)
&trans  &trans            &trans            &trans            &trans            &trans                            &trans                &trans                &trans                &trans                &trans                &trans
                                            &trans            &trans            &trans                            &mo 5                 &trans                &trans
            >;
        };

        Editor {
            bindings = <
&trans  &sys_reset  &bootloader  &studio_unlock  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans       &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans      &trans       &trans          &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans          &trans  &trans                  &trans  &trans  &trans
            >;
        };

        Control {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans           &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SPI  &rgb_ug RGB_SPD  &rgb_ug RGB_COLOR_HSB(209,68,51)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &rgb_ug RGB_TOG  &rgb_ug RGB_ON   &rgb_ug RGB_OFF  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_COLOR_HSB(0,42,45)    &trans
&trans  &trans  &trans  &trans  &trans  &trans                           &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_COLOR_HSB(272,58,50)  &trans
                        &trans  &trans  &trans                           &trans           &trans           &trans
            >;
        };
    };
};
